#include <fcntl.h>
#include <unistd.h>

#define BUF_SIZE 1024

static void write_full(int fd, const char *data, ssize_t len)
{
	ssize_t done = 0;

	while (done < len) {
		ssize_t n = write(fd, data + done, len - done);

		if (n <= 0)
			return;

		done += n;
	}
}

int main(int argc, char **argv)
{
	int nfiles = argc - 1;
	int fds[nfiles > 0 ? nfiles : 1];
	char buf[BUF_SIZE];
	ssize_t n;
	int i;

	for (i = 0; i < nfiles; i++)
		fds[i] = open(argv[i + 1], O_WRONLY | O_CREAT | O_TRUNC, 0644);

	while ((n = read(STDIN_FILENO, buf, sizeof(buf))) > 0) {
		write_full(STDOUT_FILENO, buf, n);

		for (i = 0; i < nfiles; i++)
			write_full(fds[i], buf, n);
	}

	for (i = 0; i < nfiles; i++)
		close(fds[i]);

	return 0;
}
